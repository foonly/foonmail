# Copy to local.test.env (gitignored) to run the tests that use your own
# mail. They are skipped without it.
#
#   go test -tags novulkan -run TestRealCache -v ./cmd/foonmail

# The cache foonmaild keeps.
FOONMAIL_TEST_CACHE=~/.cache/foonmail/mail.db
# The account name from your config.toml.
FOONMAIL_TEST_ACCOUNT=home
