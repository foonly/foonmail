# systemd user unit for foonmaild.
#
#   go install ./cmd/foonmaild
#   cp contrib/systemd/foonmaild.service ~/.config/systemd/user/
#   systemctl --user enable --now foonmaild
#
# Logs: journalctl --user -u foonmaild -f
#
# On Hyprland without a systemd graphical session, `exec-once = foonmaild`
# in hyprland.conf works too.

[Unit]
Description=foonmail daemon
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=%h/go/bin/foonmaild
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
